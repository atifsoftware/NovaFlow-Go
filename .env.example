APP_ENV=local
APP_PORT=8080

# Desktop Auto-Open Browser Configuration (Opens browser automatically on double-click)
AUTO_OPEN_BROWSER=true
AUTO_OPEN_PATH=/

# Database Configuration (Supported: mysql, postgres, sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novaflow_db
DB_USER=root
DB_PASS=

# PostgreSQL Example:
# DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=novaflow_db
# DB_USER=postgres
# DB_PASS=secret
# DB_SSLMODE=disable

# SQLite Example:
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite

JWT_SECRET=change-this-to-a-long-random-string

# AI Configurations
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
